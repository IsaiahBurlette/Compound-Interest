{
  "name": "compound-interest",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/web",
    "build:web": "npm run build --workspace=apps/web",
    "dev:mobile": "npm run start --workspace=apps/mobile",
    "build:core": "npm run build --workspace=packages/core",
    "test:core": "npm run test --workspace=packages/core",
    "typecheck": "npm run typecheck --workspace=packages/core && npm run typecheck --workspace=apps/web && npm run typecheck --workspace=apps/mobile"
  }
}
